# Copy to .env and fill in. Never commit .env.

APP_NAME="Pillow API"
ENVIRONMENT=development

# JSON list. Expo dev server runs on 8081; "*" is fine for a hackathon.
CORS_ORIGINS=["*"]

# Supabase (Dashboard > Project Settings > API Keys). The secret key bypasses RLS: backend only,
# never in the app, the bus or git.
SUPABASE_URL=https://bcsrfqebcsbybpylnqmc.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Shared secret the base laptop sends as "Authorization: Bearer <token>" with POST /api/pillows/{id}/checkin.
# Unset = that endpoint answers 503. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
CHECKIN_TOKEN=
