# Copy to .env and fill in. Never commit .env.

APP_NAME="Pillow API"
ENVIRONMENT=development

# JSON list. Expo dev server runs on 8081; "*" is fine for a hackathon.
CORS_ORIGINS=["*"]

# Supabase (Dashboard > Project Settings > API Keys). The secret key bypasses RLS: backend only,
# never in the app, the bus or git.
SUPABASE_URL=https://bcsrfqebcsbybpylnqmc.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Shared secret the voice laptop, Morning Brief droid and Fetch agent send as "Authorization: Bearer
# <token>" (check-in and reminder results, family writes). The same value on every device.
# Unset = those endpoints answer 503. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
CHECKIN_TOKEN=

# Family Liaison words alerts with Claude. Unset = fixed alert text.
ANTHROPIC_API_KEY=

# Family alerts to real phones (app/notify/sender.py). Set these on the VPS only, or alerts would
# go out twice. An "sms" alert goes as an iMessage through Photon, falling back to Twilio SMS; a
# "call" alert is a Twilio call. Unset = those alerts stay queued (the app still shows them).
# Photon (app.photon.codes > project Settings), read by the deploy/imessage sidecar. Free tier:
# add each family phone as a User in the dashboard, or sends fail "Target not allowed".
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Set by deploy/compose.yml on the VPS; locally, run the sidecar and use http://127.0.0.1:8787
IMESSAGE_URL=
# Twilio (console.twilio.com). A trial account only reaches numbers verified on it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# JSON list of pillows whose alerts reach real phones; test pillows never text anyone
NOTIFY_PILLOW_IDS=["mum"]
