# Copy to .env and fill in. Never commit .env.
# EXPO_PUBLIC_ vars are bundled into the app, so never put secrets here.

# Backend base URL. On a physical phone use your computer's LAN IP (e.g. http://192.168.1.20:8000),
# not localhost. Android emulator: http://10.0.2.2:8000.
EXPO_PUBLIC_API_URL=http://localhost:8000
